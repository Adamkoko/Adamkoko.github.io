<!DOCTYPE html>  
<html lang="en">  
<head>  
  <meta charset="UTF-8" />  
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />  
  <meta name="description" content="The official personal website of Adam Koko." />  
  <meta name="author" content="Adam Koko" />  
  <title>Adam Koko Website</title>  
  
  <style>  
    :root {  
      --primary-color: #2563eb;  
      --primary-dark: #1d4ed8;  
      --dark-color: #0f172a;  
      --text-color: #334155;  
      --light-text: #64748b;  
      --background-color: #f8fafc;  
      --white-color: #ffffff;  
      --border-color: #e2e8f0;  
      --card-shadow: 0 12px 30px rgba(15, 23, 42, 0.1);  
      --max-width: 1120px;  
    }  
  
    * { box-sizing: border-box; margin: 0; padding: 0; }  
    html { scroll-behavior: smooth; }  
  
    body {  
      background: var(--background-color);  
      color: var(--text-color);  
      font-family: Arial, Helvetica, sans-serif;  
      line-height: 1.6;  
    }  
  
    img { display: block; max-width: 100%; }  
    a { color: inherit; text-decoration: none; }  
    ul { list-style: none; }  
  
    .container { width: min(90%, var(--max-width)); margin: 0 auto; }  
    .section { padding: 90px 0; }  
  
    .section-heading { margin-bottom: 45px; text-align: center; }  
    .section-heading h2 {  
      color: var(--dark-color);  
      font-size: clamp(2rem, 4vw, 3rem);  
      margin-bottom: 12px;  
    }  
    .section-heading p { color: var(--light-text); margin: 0 auto; max-width: 650px; }  
  
    .button {  
      background: var(--primary-color);  
      border: 2px solid var(--primary-color);  
      border-radius: 8px;  
      color: var(--white-color);  
      cursor: pointer;  
      display: inline-block;  
      font-weight: 700;  
      padding: 13px 24px;  
      transition: all 0.3s ease;  
    }  
    .button:hover {  
      background: var(--primary-dark);  
      border-color: var(--primary-dark);  
      transform: translateY(-2px);  
    }  
    .button-outline { background: transparent; color: var(--primary-color); margin-left: 10px; }  
    .button-outline:hover { color: var(--white-color); }  
  
    /* Navigation */  
    .navbar {  
      background: var(--white-color);  
      border-bottom: 1px solid var(--border-color);  
      position: sticky;  
      top: 0;  
      z-index: 1000;  
    }  
    .nav-container {  
      align-items: center;  
      display: flex;  
      justify-content: space-between;  
      min-height: 72px;  
    }  
    .logo { color: var(--dark-color); font-size: 1.35rem; font-weight: 800; }  
    .logo span { color: var(--primary-color); }  
    .nav-menu { align-items: center; display: flex; gap: 28px; }  
    .nav-link { color: var(--text-color); font-size: 0.95rem; font-weight: 600; }  
    .nav-link:hover { color: var(--primary-color); }  
    .menu-toggle {  
      background: transparent;  
      border: 0;  
      color: var(--dark-color);  
      cursor: pointer;  
      display: none;  
      font-size: 1.8rem;  
    }  
  
    /* Hero */  
    .hero { background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%); padding: 100px 0; }  
    .hero-content {  
      align-items: center;  
      display: grid;  
      gap: 55px;  
      grid-template-columns: 1fr 1fr;  
    }  
    .hero-text .eyebrow {  
      color: var(--primary-color);  
      font-size: 0.9rem;  
      font-weight: 800;  
      letter-spacing: 2px;  
      text-transform: uppercase;  
      margin-bottom: 15px;  
    }  
    .hero-text h1 {  
      color: var(--dark-color);  
      font-size: clamp(2.5rem, 6vw, 5rem);  
      letter-spacing: -2px;  
      line-height: 1.05;  
      margin-bottom: 22px;  
    }  
    .hero-text h1 span { color: var(--primary-color); }  
    .hero-text p { color: var(--light-text); font-size: 1.1rem; margin-bottom: 30px; }  
    .hero-image {  
      border-radius: 20px;  
      box-shadow: var(--card-shadow);  
      height: 500px;  
      object-fit: cover;  
      width: 100%;  
    }  
  
    /* About */  
    .about { background: var(--white-color); }  
    .about-content {  
      align-items: center;  
      display: grid;  
      gap: 60px;  
      grid-template-columns: 0.85fr 1.15fr;  
    }  
    .about-image {  
      border-radius: 16px;  
      box-shadow: var(--card-shadow);  
      height: 450px;  
      object-fit: cover;  
      width: 100%;  
    }  
    .about-text h3 { color: var(--dark-color); font-size: 2rem; margin-bottom: 18px; }  
    .about-text p { color: var(--light-text); margin-bottom: 18px; }  
    .about-list { display: grid; gap: 12px; margin-top: 25px; }  
    .about-list li { color: var(--text-color); font-weight: 600; }  
    .about-list li::before { color: var(--primary-color); content: "✓"; font-weight: 900; margin-right: 10px; }  
  
    /* Gallery */  
    .gallery-grid { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); }  
    .gallery-item {  
      border-radius: 14px;  
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);  
      overflow: hidden;  
    }  
    .gallery-item img { height: 280px; object-fit: cover; transition: transform 0.4s ease; width: 100%; }  
    .gallery-item:hover img { transform: scale(1.06); }  
  
    /* Contact */  
    .contact { background: #eff6ff; }  
    .contact-content { display: grid; gap: 50px; grid-template-columns: 0.8fr 1.2fr; }  
    .contact-info h3 { color: var(--dark-color); font-size: 2rem; margin-bottom: 18px; }  
    .contact-info p { color: var(--light-text); margin-bottom: 25px; }  
    .contact-details { display: grid; gap: 15px; }  
    .contact-details strong { color: var(--dark-color); display: block; }  
    .contact-form {  
      background: var(--white-color);  
      border-radius: 14px;  
      box-shadow: var(--card-shadow);  
      padding: 32px;  
    }  
    .form-group { margin-bottom: 20px; }  
    .form-group label { color: var(--dark-color); display: block; font-weight: 700; margin-bottom: 8px; }  
    .form-group input,  
    .form-group textarea {  
      border: 1px solid var(--border-color);  
      border-radius: 7px;  
      font: inherit;  
      padding: 12px 14px;  
      width: 100%;  
    }  
    .form-group input:focus,  
    .form-group textarea:focus {  
      border-color: var(--primary-color);  
      outline: none;  
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);  
    }  
    .form-group textarea { min-height: 140px; resize: vertical; }  
    .form-message { color: #15803d; display: none; font-weight: 600; margin-top: 15px; }  
  
    /* Footer */  
    .footer { background: var(--dark-color); color: #cbd5e1; padding: 30px 0; text-align: center; }  
  
    /* Responsive */  
    @media (max-width: 800px) {  
      .menu-toggle { display: block; }  
      .nav-menu {  
        background: var(--white-color);  
        border-top: 1px solid var(--border-color);  
        display: none;  
        flex-direction: column;  
        left: 0;  
        padding: 15px 5%;  
        position: absolute;  
        top: 72px;  
        width: 100%;  
      }  
      .nav-menu.active { display: flex; }  
      .nav-link { border-bottom: 1px solid var(--border-color); padding: 14px 0; width: 100%; }  
      .nav-link:last-child { border-bottom: 0; }  
      .hero-content, .about-content, .contact-content { grid-template-columns: 1fr; }  
      .hero-image { height: 380px; }  
      .about-image { height: 350px; }  
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }  
    }  
    @media (max-width: 520px) {  
      .section { padding: 65px 0; }  
      .hero-image, .about-image { height: 300px; }  
      .gallery-grid { grid-template-columns: 1fr; }  
      .gallery-item img { height: 260px; }  
ed    }  
  </style>  
</head>  
  
<body>  
  <!-- Navigation -->  
  <header class="navbar">  
    <div class="container nav-container">  
      <a class="logo" href="#home">Adam <span>Koko</span></a>  
      <button class="menu-toggle" id="menuToggle" aria-label="Open navigation menu">☰</button>  
      <nav aria-label="Main navigation">  
        <ul class="nav-menu" id="navMenu">  
          <li><a class="nav-link" href="#home">Home</a></li>  
          <li><a class="nav-link" href="#about">About</a></li>  
          <li><a class="nav-link" href="#gallery">Gallery</a></li>  
          <li><a class="nav-link" href="#contact">Contact</a></li>  
        </ul>  
      </nav>  
    </div>  
  </header>  
  
  <main>  
    <!-- Hero -->  
    <section class="hero" id="home">  
      <div class="container hero-content">  
        <div class="hero-text">  
          <p class="eyebrow">Welcome to my website</p>  
          <h1>Hello, I'm <span>Adam Koko</span></h1>  
          <p>  
            Welcome to my personal website. Explore my story, discover my  
            favorite moments, and learn more about the things that inspire me.  
          </p>  
          <a class="button" href="#about">Learn More</a>  
          <a class="button button-outline" href="#contact">Contact Me</a>  
        </div>  
        <img class="hero-image" src="https://picsum.photos/id/1011/900/700" alt="Mountain landscape" />  
      </div>  
    </section>  
  
    <!-- About -->  
    <section class="section about" id="about">  
      <div class="container">  
        <div class="section-heading">  
          <h2>About Me</h2>  
          <p>A little information about who I am and what I enjoy doing.</p>  
        </div>  
        <div class="about-content">  
          <img class="about-image" src="https://picsum.photos/id/1005/700/800" alt="Portrait-style image" />  
          <div class="about-text">  
            <h3>Nice to meet you!</h3>  
            <p>  
              My name is Adam Koko. I enjoy learning new skills, exploring  
              creative ideas, and connecting with people from different backgrounds.  
            </p>  
            <p>  
              This website is a place where I can share a little about myself,  
              display memorable images, and keep in touch with visitors.  
            </p>  
            <ul class="about-list">  
              <li>Creative and curious</li>  
              <li>Always learning something new</li>  
              <li>Interested in technology and design</li>  
            </ul>  
          </div>  
        </div>  
      </div>  
    </section>  
  
    <!-- Gallery -->  
    <section class="section gallery" id="gallery">  
      <div class="container">  
        <div class="section-heading">  
          <h2>Photo Gallery</h2>  
          <p>A collection of beautiful places and moments.</p>  
        </div>  
        <div class="gallery-grid">  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1015/700/500" alt="River through mountains" loading="lazy" /></figure>  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1016/700/500" alt="Forest scenery" loading="lazy" /></figure>  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1025/700/500" alt="Dog looking at camera" loading="lazy" /></figure>  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1035/700/500" alt="Mountain landscape" loading="lazy" /></figure>  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1043/700/500" alt="Outdoor landscape" loading="lazy" /></figure>  
          <figure class="gallery-item"><img src="https://picsum.photos/id/1069/700/500" alt="Ocean coastline" loading="lazy" /></figure>  
        </div>  
      </div>  
    </section>  
  
    <!-- Contact -->  
    <section class="section contact" id="contact">  
      <div class="container">  
        <div class="section-heading">  
          <h2>Get in Touch</h2>  
          <p>Have a question or want to say hello? Send me a message.</p>  
        </div>  
        <div class="contact-content">  
          <div class="contact-info">  
            <h3>Let's connect</h3>  
            <p>I would be happy to hear from you. Complete the form, and I will get back to you as soon as possible.</p>  
            <div class="contact-details">  
              <p><strong>Email</strong> adam.koko@example.com</p>  
              <p><strong>Location</strong> Your City, Your Country</p>  
            </div>  
          </div>  
          <form class="contact-form" id="contactForm">  
            <div class="form-group">  
              <label for="name">Name</label>  
              <input type="text" id="name" name="name" placeholder="Your name" required />  
            </div>  
            <div class="form-group">  
              <label for="email">Email</label>  
              <input type="email" id="email" name="email" placeholder="you@example.com" required />  
            </div>  
            <div class="form-group">  
              <label for="message">Message</label>  
              <textarea id="message" name="message" placeholder="Write your message here..." required></textarea>  
            </div>  
            <button class="button" type="submit">Send Message</button>  
            <p class="form-message" id="formMessage">Thank you! Your message has been received.</p>  
          </form>  
        </div>  
      </div>  
    </section>  
  </main>  
  
  <!-- Footer -->  
  <footer class="footer">  
    <div class="container">  
      <p>&copy; <span id="currentYear"></span> Adam Koko Website. All rights reserved.</p>  
    </div>  
  </footer>  
  
  <script>  
    // Mobile menu toggle  
    const menuToggle = document.getElementById("menuToggle");  
    const navMenu = document.getElementById("navMenu");  
    menuToggle.addEventListener("click", () => {  
      navMenu.classList.toggle("active");  
et    });  
  
    // Current year in footer  
    document.getElementById("currentYear").textContent = new Date().getFullYear();  
  
    // Demo form behavior (connect to a backend or form service for real messages)  
    const contactForm = document.getElementById("contactForm");  
    contactForm.addEventListener("submit", (event) => {  
      event.preventDefault();  
      document.getElementById("formMessage").style.display = "block";  
      contactForm.reset();  
    });  
  </script>  
</body>  
</html>  
